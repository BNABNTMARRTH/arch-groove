#!/usr/bin/env python3
import glob
import json
import os
import subprocess
import sys
import uuid

def get_wayland_env():
    env = os.environ.copy()
    env.setdefault("XDG_RUNTIME_DIR", "/run/user/1000")
    env.setdefault("DBUS_SESSION_BUS_ADDRESS", "unix:path=/run/user/1000/bus")
    env.setdefault("QT_QPA_PLATFORM", "wayland")
    socks = sorted(glob.glob("/run/user/1000/wayland-*"))
    socks = [s for s in socks if not s.endswith(".lock")]
    if socks:
        env["WAYLAND_DISPLAY"] = os.path.basename(socks[0])
    else:
        env.setdefault("WAYLAND_DISPLAY", "wayland-1")
    return env

def run_cmd(cmd, as_alarm=False, wayland=False, timeout=30):
    env = get_wayland_env() if wayland else os.environ.copy()
    if as_alarm and os.geteuid() == 0:
        env_prefix = (
            f"DBUS_SESSION_BUS_ADDRESS={env.get('DBUS_SESSION_BUS_ADDRESS')} "
            f"WAYLAND_DISPLAY={env.get('WAYLAND_DISPLAY')} "
            f"XDG_RUNTIME_DIR={env.get('XDG_RUNTIME_DIR')} "
            f"QT_QPA_PLATFORM=wayland"
        )
        full_cmd = ["su", "-", "alarm", "-c", f"{env_prefix} {cmd}"]
        return subprocess.run(full_cmd, capture_output=True, text=True, timeout=timeout)
    return subprocess.run(cmd, shell=isinstance(cmd, str), env=env, capture_output=True, text=True, timeout=timeout)

TOOLS = [
    {
        "name": "screen_capture",
        "description": "Capture the active KDE Plasma Wayland screen using spectacle and return the saved PNG path.",
        "inputSchema": {
            "type": "object",
            "properties": {"output_path": {"type": "string", "default": "/tmp/groovecore_screen.png"}},
        },
    },
    {
        "name": "mouse_move",
        "description": "Move the mouse cursor to absolute or relative coordinates using ydotool.",
        "inputSchema": {
            "type": "object",
            "properties": {
                "x": {"type": "integer"},
                "y": {"type": "integer"},
                "absolute": {"type": "boolean", "default": True},
            },
            "required": ["x", "y"],
        },
    },
    {
        "name": "mouse_click",
        "description": "Click mouse button (left, right, middle) using ydotool.",
        "inputSchema": {
            "type": "object",
            "properties": {"button": {"type": "string", "enum": ["left", "right", "middle"], "default": "left"}},
        },
    },
    {
        "name": "keyboard_type",
        "description": "Type text into the focused Wayland window using ydotool.",
        "inputSchema": {
            "type": "object",
            "properties": {"text": {"type": "string"}},
            "required": ["text"],
        },
    },
    {
        "name": "clipboard_get",
        "description": "Read current Wayland clipboard text via wl-paste.",
        "inputSchema": {"type": "object", "properties": {}},
    },
    {
        "name": "clipboard_set",
        "description": "Write text to the Wayland clipboard via wl-copy.",
        "inputSchema": {
            "type": "object",
