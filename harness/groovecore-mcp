    },
]

def handle_tool(name, args):
    if name == "screen_capture":
        out = args.get("output_path", "/tmp/groovecore_screen.png")
        r = run_cmd(f"spectacle -b -n -o {out}", as_alarm=True, wayland=True)
        return f"Captured to {out}" if r.returncode == 0 else f"Error: {r.stderr}"
    if name == "mouse_move":
        x, y = int(args["x"]), int(args["y"])
        flag = "-a" if args.get("absolute", True) else ""
        r = run_cmd(f"ydotool mousemove {flag} -x {x} -y {y}", as_alarm=True)
        return "OK" if r.returncode == 0 else f"Error: {r.stderr}"
    if name == "mouse_click":
        btn_map = {"left": "0xC0", "right": "0xC1", "middle": "0xC2"}
        code = btn_map.get(args.get("button", "left"), "0xC0")
        r = run_cmd(f"ydotool click {code}", as_alarm=True)
        return "OK" if r.returncode == 0 else f"Error: {r.stderr}"
    if name == "keyboard_type":
        txt = args["text"].replace("'", "'\"'\"'")
        r = run_cmd(f"ydotool type '{txt}'", as_alarm=True)
        return "OK" if r.returncode == 0 else f"Error: {r.stderr}"
    if name == "clipboard_get":
        r = run_cmd("wl-paste -n", as_alarm=True, wayland=True)
        return r.stdout if r.returncode == 0 else f"Error: {r.stderr}"
    if name == "clipboard_set":
        txt = args["text"].replace("'", "'\"'\"'")
        r = run_cmd(f"printf '%s' '{txt}' | wl-copy", as_alarm=True, wayland=True)
        return "OK" if r.returncode == 0 else f"Error: {r.stderr}"
    if name == "tmux_run":
        sess = args.get("session", "groovecore")
        cmd = args["command"].replace("'", "'\"'\"'")
        run_cmd(f"tmux has-session -t {sess} 2>/dev/null || tmux new-session -d -s {sess}", as_alarm=True)
        r = run_cmd(f"tmux send-keys -t {sess} '{cmd}' C-m", as_alarm=True)
        return f"Sent to tmux:{sess}" if r.returncode == 0 else f"Error: {r.stderr}"
    if name == "tmux_read":
        sess = args.get("session", "groovecore")
        lines = int(args.get("lines", 50))
        r = run_cmd(f"tmux capture-pane -t {sess} -p -S -{lines}", as_alarm=True)
        return r.stdout if r.returncode == 0 else f"Error: {r.stderr}"
    if name == "delegate_agent":
        sess = args.get("session") or f"agent-{uuid.uuid4().hex[:6]}"
        task = args["task"].replace("'", "'\"'\"'")
        run_cmd(f"tmux new-session -d -s {sess}", as_alarm=True)
        r = run_cmd(f"tmux send-keys -t {sess} 'opencode run \"{task}\"' C-m", as_alarm=True)
        return f"Delegated to tmux session '{sess}'. Use tmux_read(session='{sess}') to inspect progress."
    if name == "system_snapshot":
        r = run_cmd("uname -a && df -h / && free -h && ls /run/user/1000/wayland-* 2>/dev/null")
        return r.stdout
    return f"Unknown tool: {name}"

def main():
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        req = json.loads(line)
        rid = req.get("id")
        method = req.get("method")
        if method == "initialize":
            resp = {
                "jsonrpc": "2.0",
                "id": rid,
                "result": {
                    "protocolVersion": "2024-11-05",
                    "capabilities": {"tools": {}},
                    "serverInfo": {"name": "groovecore-mcp", "version": "1.0.0"},
                },
            }
        elif method == "tools/list":
            resp = {"jsonrpc": "2.0", "id": rid, "result": {"tools": TOOLS}}
        elif method == "tools/call":
            params = req.get("params", {})
            out = handle_tool(params.get("name"), params.get("arguments", {}))
            resp = {"jsonrpc": "2.0", "id": rid, "result": {"content": [{"type": "text", "text": str(out)}]}}
        elif rid is not None:
            resp = {"jsonrpc": "2.0", "id": rid, "result": {}}
        else:
            continue
        sys.stdout.write(json.dumps(resp) + "\n")
        sys.stdout.flush()

if __name__ == "__main__":
    main()
